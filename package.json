{
  "name": "pw-test",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",

  "scripts": {
    "clean-results": "rimraf allure-results && rimraf playwright-report",
    "run-test": "npx playwright test --reporter=line,allure-playwright",
    "generate-report": "allure generate --single-file allure-results --clean -o allure-report ",
    "open-report": "allure serve",
    "local-test": "npm run clean-results && npm run run-test & npm run generate-report && npm run open-report",
    "ci-test": "npm run clean-results && npm run run-test --trace on & npm run generate-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.19",
    "allure-playwright": "^3.0.0"
  },
  "dependencies": {
    "allure-commandline": "^2.42.0",
    "csv-parse": "^6.2.1",
    "rimraf": "^6.1.3"
  }
}
